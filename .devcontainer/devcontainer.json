// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "uv tool install pre-commit --with pre-commit-uv --force-reinstall --force -p 3.12 && uv sync --all-extras -p 3.12",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml",
        "esbenp.prettier-vscode",
        "oderwat.indent-rainbow",
        "charliermarsh.ruff",
        "github.vscode-github-actions",
        "nickmillerdev.pytest-fixtures",
        "editorconfig.editorcon",
        "streetsidesoftware.code-spell-checker",
        "me-dutour-mathieu.vscode-github-actions"
      ]
    }
  },
  "containerEnv": { "XDG_CACHE_HOME": "/workspaces/openapi-diagram/.cache" }

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
